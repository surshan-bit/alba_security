{
  "name": "alba-tv-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "TV_MCP_URL": "https://mcp.tradingview.com/mcp" },
  // No id on purpose: Cloudflare creates the TV_KV storage by itself on the first deploy.
  "kv_namespaces": [{ "binding": "TV_KV" }]
}
