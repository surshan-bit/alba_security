{
  "name": "alba-screener",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "BATCH_MAX": "20" },
  // At most 30 requests a minute per client address, counted by src/ratelimit.js. Cloudflare counts per location, so this is a brake, not an exact meter.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
